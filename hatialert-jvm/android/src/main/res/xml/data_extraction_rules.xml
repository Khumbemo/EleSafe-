<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing is copied to cloud backups or to a new phone. The app keeps
  a sign-in token (encrypted with a key that never leaves this phone) and reports
  waiting to be sent; both belong to this device only. allowBackup="false" in the
  manifest covers Android 11 and older.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
