<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Allows plain HTTP to any address so the app can reach
  `python -m hatialert --host 0.0.0.0` on a laptop in the same Wi-Fi
  (e.g. http://192.168.1.20:8000); Android can't match IP ranges, so the
  local addresses can't be listed one by one. Release builds use
  src/main/res/xml/network_security_config.xml (emulator and localhost only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
