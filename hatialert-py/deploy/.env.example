# HatiAlert deployment settings.
# Copy this file to .env in the same folder and fill it in:  cp .env.example .env
# .env holds secrets (SMS key). It is git-ignored: never commit it, never paste
# it into chat or email. Every value below is a PLACEHOLDER.

# --- Address -----------------------------------------------------------------
# The domain name people will open on their phones. Its DNS "A" (and "AAAA" if
# the server has IPv6) record must point to this server before you start.
HATIALERT_DOMAIN=hatialert.example.org
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=it-admin@example.org

# Leave at 80/443 on a real server (Let's Encrypt needs port 80 reachable).
# HTTP_PORT=80
# HTTPS_PORT=443

# --- App ---------------------------------------------------------------------
# 1 = load demo accounts (PINs 1111/2222/3333) and sample incidents into an
# EMPTY database. Only for trying it out; they stay in the database afterwards.
HATIALERT_DEMO=0
# Automatic backups inside the data volume (/data/backups).
HATIALERT_BACKUP_HOURS=24
HATIALERT_BACKUP_KEEP=14

# --- Text messages (SMS) -------------------------------------------------------
# Leave HATIALERT_SMS_URL empty until a provider is set up (alerts are then sent
# by hand from More > Admin > Messages). See README.md, "Text messages".
HATIALERT_SMS_URL=
# Full value of the Authorization header, e.g. "Bearer <key>" or just "<key>",
# exactly as your provider's documentation says.
HATIALERT_SMS_AUTH=
# JSON body sent for each message; {to} and {message} are filled in. Keep the
# single quotes. Empty = {"to": "{to}", "message": "{message}"}.
# HATIALERT_SMS_BODY='{"sender": "REPLACE", "template_id": "REPLACE", "to": "{to}", "text": "{message}"}'
HATIALERT_SMS_BODY=
# Put before the 10-digit number: +91, 91 or nothing, as the provider expects.
HATIALERT_SMS_PREFIX=+91
# 1 = print messages in the log instead of sending (testing only).
HATIALERT_SMS_DEBUG=0

# --- Off-server backups (backup-offsite.sh) --------------------------------------
# rsync: OFFSITE_TARGET=backup-user@backup-host.example.org:/srv/hatialert-backups/
# rclone: OFFSITE_TARGET=myremote:hatialert-backups   (set up with "rclone config")
# none: only copy into OFFSITE_STAGING on this server
OFFSITE_METHOD=none
OFFSITE_TARGET=
OFFSITE_STAGING=./offsite-staging
OFFSITE_KEEP=30
