{
  "name": "hatialert-web",
  "private": true,
  "version": "1.0.0",
  "description": "TypeScript source of the HatiAlert browser client (builds hatialert/web/app.js, nagamese.js and sw.js)",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test:browser": "node ../tests/browser/run.cjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "typescript": "6.0.3"
  }
}
